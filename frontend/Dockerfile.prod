FROM node:20-alpine AS build

WORKDIR /app

ARG VITE_API_URL=
ARG VITE_TITILER_ENDPOINT=https://titiler.xyz
ARG VITE_STAC_API_URL=https://earth-search.aws.element84.com/v1
ARG VITE_SENTINEL2_COLLECTION=sentinel-2-l2a

ENV VITE_API_URL=$VITE_API_URL \
    VITE_TITILER_ENDPOINT=$VITE_TITILER_ENDPOINT \
    VITE_STAC_API_URL=$VITE_STAC_API_URL \
    VITE_SENTINEL2_COLLECTION=$VITE_SENTINEL2_COLLECTION

COPY package*.json ./
RUN npm install

COPY . .
RUN npm run build

FROM nginx:1.27-alpine

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80
